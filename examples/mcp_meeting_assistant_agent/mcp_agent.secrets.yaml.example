# MCP Agent Secrets Configuration
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

# Anthropic API key for Claude LLM
ANTHROPIC_API_KEY: "your-anthropic-api-key-here"

# Google Calendar API credentials
GOOGLE_CALENDAR_CLIENT_ID: "your-google-client-id"
GOOGLE_CALENDAR_CLIENT_SECRET: "your-google-client-secret" 
GOOGLE_CALENDAR_REFRESH_TOKEN: "your-refresh-token"

# Gmail API credentials (for email notifications)
GMAIL_CLIENT_ID: "your-gmail-client-id"
GMAIL_CLIENT_SECRET: "your-gmail-client-secret"
GMAIL_REFRESH_TOKEN: "your-gmail-refresh-token"

# Brave Search API key (for meeting research)
BRAVE_SEARCH_API_KEY: "your-brave-search-api-key"

# Notion API key (for document management)
NOTION_TOKEN: "your-notion-api-token"
NOTION_DATABASE_ID: "your-notion-database-id"

# Optional: Zoom API credentials (for meeting creation)
ZOOM_CLIENT_ID: "your-zoom-client-id"
ZOOM_CLIENT_SECRET: "your-zoom-client-secret"
ZOOM_ACCOUNT_ID: "your-zoom-account-id"

# Optional: Microsoft Teams credentials
TEAMS_CLIENT_ID: "your-teams-client-id"
TEAMS_CLIENT_SECRET: "your-teams-client-secret"
TEAMS_TENANT_ID: "your-teams-tenant-id"

# Optional: Slack API credentials (for notifications)
SLACK_BOT_TOKEN: "your-slack-bot-token"
SLACK_CHANNEL: "#meetings"