# Energy Grid Management Agent Secrets
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

anthropic:
  api_key: "sk-ant-your-anthropic-api-key-here"

# Database connection for energy grid data
postgres:
  connection_string: "postgresql://username:password@localhost:5432/energy_grid_db"

# External API keys for energy and weather services
apis:
  eia_api_key: "your-energy-information-administration-api-key"
  noaa_weather_api_key: "your-noaa-weather-api-key"
  openweather_api_key: "your-openweather-api-key"
  pjm_api_key: "your-pjm-interconnection-api-key"
  caiso_api_key: "your-california-iso-api-key"
  ercot_api_key: "your-ercot-api-key"
  iso_ne_api_key: "your-iso-new-england-api-key"
  scada_system_key: "your-scada-system-integration-key"
  smart_meter_api_key: "your-smart-meter-api-key"