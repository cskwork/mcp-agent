# Medical Research and Clinical Trial Agent Secrets
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

anthropic:
  api_key: "sk-ant-your-anthropic-api-key-here"

# Database connection for research data
postgres:
  connection_string: "postgresql://username:password@localhost:5432/medical_research_db"

# External API keys for medical research services
apis:
  pubmed_api_key: "your-ncbi-pubmed-api-key"
  clinicaltrials_gov_api: "your-clinicaltrials-api-key"
  fda_api_key: "your-fda-api-key"
  ehr_system_key: "your-ehr-integration-key"