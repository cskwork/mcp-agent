# Smart City Infrastructure Agent Secrets
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

anthropic:
  api_key: "sk-ant-your-anthropic-api-key-here"

# Database connection for city data
postgres:
  connection_string: "postgresql://username:password@localhost:5432/smart_city_db"

# External API keys for city services
apis:
  weather_api_key: "your-weather-api-key"
  traffic_api_key: "your-traffic-data-api-key"
  energy_grid_key: "your-energy-grid-api-key"
  gis_service_key: "your-gis-service-api-key"
  iot_platform_key: "your-iot-platform-api-key"
  notification_service_key: "your-notification-service-key"