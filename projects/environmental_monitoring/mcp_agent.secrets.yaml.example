# Environmental Monitoring Agent Secrets
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

anthropic:
  api_key: "sk-ant-your-anthropic-api-key-here"

# Database connection for environmental data
postgres:
  connection_string: "postgresql://username:password@localhost:5432/environmental_monitoring_db"

# External API keys for environmental monitoring services
apis:
  epa_api_key: "your-epa-air-quality-api-key"
  noaa_api_key: "your-noaa-climate-api-key"
  nasa_api_key: "your-nasa-earth-data-api-key"
  openweather_api_key: "your-openweather-api-key"
  purpleair_api_key: "your-purpleair-api-key"
  airnow_api_key: "your-airnow-api-key"
  usgs_api_key: "your-usgs-water-data-api-key"
  aqicn_api_key: "your-aqicn-api-key"
  sentinel_hub_api_key: "your-sentinel-hub-api-key"
  planet_api_key: "your-planet-imagery-api-key"
  worldbank_api_key: "your-world-bank-climate-api-key"
  carbon_interface_api_key: "your-carbon-interface-api-key"
  climatiq_api_key: "your-climatiq-api-key"