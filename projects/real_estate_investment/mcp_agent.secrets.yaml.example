# Real Estate Investment Agent Secrets
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

anthropic:
  api_key: "sk-ant-your-anthropic-api-key-here"

# Database connection for real estate data
postgres:
  connection_string: "postgresql://username:password@localhost:5432/real_estate_db"

# External API keys for real estate and financial services
apis:
  zillow_api_key: "your-zillow-api-key"
  realtor_api_key: "your-realtor-com-api-key"
  redfin_api_key: "your-redfin-api-key"
  mls_api_key: "your-mls-api-key"
  rentals_api_key: "your-rentals-api-key"
  mortgage_api_key: "your-mortgage-rates-api-key"
  census_api_key: "your-us-census-api-key"
  bls_api_key: "your-bureau-labor-statistics-api-key"
  fred_api_key: "your-federal-reserve-economic-data-api-key"
  google_maps_api_key: "your-google-maps-api-key"
  walk_score_api_key: "your-walk-score-api-key"
  crime_data_api_key: "your-crime-data-api-key"
  school_api_key: "your-school-ratings-api-key"