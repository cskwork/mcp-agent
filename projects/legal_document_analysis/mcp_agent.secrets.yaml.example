# Legal Document Analysis Agent Secrets
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

anthropic:
  api_key: "sk-ant-your-anthropic-api-key-here"

# Database connection for legal documents and case data
postgres:
  connection_string: "postgresql://username:password@localhost:5432/legal_documents_db"

# External API keys for legal research services
apis:
  westlaw_api_key: "your-westlaw-api-key"
  lexis_nexis_api_key: "your-lexis-nexis-api-key"
  courtlistener_api_key: "your-courtlistener-api-key"
  justia_api_key: "your-justia-api-key"
  legal_zoom_api_key: "your-legal-zoom-api-key"
  pacer_api_key: "your-pacer-api-key"
  sec_edgar_api_key: "your-sec-edgar-api-key"