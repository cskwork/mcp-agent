# Cybersecurity Threat Intelligence Agent Secrets
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

anthropic:
  api_key: "sk-ant-your-anthropic-api-key-here"

# Database connection for threat intelligence data
postgres:
  connection_string: "postgresql://username:password@localhost:5432/threat_intelligence_db"

# External API keys for threat intelligence services
apis:
  virustotal_api_key: "your-virustotal-api-key"
  shodan_api_key: "your-shodan-api-key"
  alienvault_api_key: "your-otx-alienvault-api-key"
  threatcrowd_api_key: "your-threatcrowd-api-key"
  misp_api_key: "your-misp-api-key"
  misp_url: "https://your-misp-instance.com"
  cve_api_key: "your-cve-api-key"
  nist_nvd_api_key: "your-nist-nvd-api-key"
  passivetotal_api_key: "your-passivetotal-api-key"
  recorded_future_api_key: "your-recorded-future-api-key"
  crowdstrike_api_key: "your-crowdstrike-api-key"
  splunk_api_key: "your-splunk-api-key"
  elastic_api_key: "your-elasticsearch-api-key"