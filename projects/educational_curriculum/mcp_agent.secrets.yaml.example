# Educational Curriculum Agent Secrets
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

anthropic:
  api_key: "sk-ant-your-anthropic-api-key-here"

# Database connection for educational data
postgres:
  connection_string: "postgresql://username:password@localhost:5432/educational_curriculum_db"

# External API keys for educational services
apis:
  khan_academy_api_key: "your-khan-academy-api-key"
  coursera_api_key: "your-coursera-api-key"
  edx_api_key: "your-edx-api-key"
  canvas_api_key: "your-canvas-lms-api-key"
  blackboard_api_key: "your-blackboard-api-key"
  google_classroom_api_key: "your-google-classroom-api-key"
  microsoft_education_api_key: "your-microsoft-education-api-key"
  turnitin_api_key: "your-turnitin-api-key"
  pearson_api_key: "your-pearson-education-api-key"
  mcgraw_hill_api_key: "your-mcgraw-hill-api-key"
  cengage_api_key: "your-cengage-learning-api-key"
  common_core_api_key: "your-common-core-standards-api-key"
  department_education_api_key: "your-dept-education-api-key"