# MCP Agent Secrets Configuration
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

# Anthropic API key for Claude LLM
ANTHROPIC_API_KEY: "your-anthropic-api-key-here"

# Google Workspace API credentials
GOOGLE_CLIENT_ID: "your-google-client-id"
GOOGLE_CLIENT_SECRET: "your-google-client-secret"
GOOGLE_REFRESH_TOKEN: "your-google-refresh-token"

# Microsoft Office 365 API credentials
OFFICE365_CLIENT_ID: "your-office365-client-id"
OFFICE365_CLIENT_SECRET: "your-office365-client-secret"
OFFICE365_TENANT_ID: "your-office365-tenant-id"

# Gmail API credentials (for notifications)
GMAIL_CLIENT_ID: "your-gmail-client-id"
GMAIL_CLIENT_SECRET: "your-gmail-client-secret"
GMAIL_REFRESH_TOKEN: "your-gmail-refresh-token"

# Brave Search API key (for content research)
BRAVE_SEARCH_API_KEY: "your-brave-search-api-key"

# Optional: SharePoint credentials
SHAREPOINT_SITE_URL: "your-sharepoint-site-url"
SHAREPOINT_CLIENT_ID: "your-sharepoint-client-id"
SHAREPOINT_CLIENT_SECRET: "your-sharepoint-client-secret"

# Optional: Confluence credentials
CONFLUENCE_BASE_URL: "your-confluence-base-url"
CONFLUENCE_API_TOKEN: "your-confluence-api-token"
CONFLUENCE_USER_EMAIL: "your-confluence-email"

# Optional: Notion credentials
NOTION_TOKEN: "your-notion-api-token"
NOTION_DATABASE_ID: "your-notion-database-id"

# Optional: Slack credentials (for notifications)
SLACK_BOT_TOKEN: "your-slack-bot-token"
SLACK_CHANNEL: "#documents"

# Optional: GitHub credentials (for version control)
GITHUB_TOKEN: "your-github-personal-access-token"
GITHUB_REPO: "your-organization/document-repo"

# Optional: Adobe Sign credentials (for e-signatures)
ADOBE_SIGN_CLIENT_ID: "your-adobe-sign-client-id"
ADOBE_SIGN_CLIENT_SECRET: "your-adobe-sign-client-secret"

# Optional: DocuSign credentials
DOCUSIGN_CLIENT_ID: "your-docusign-client-id"
DOCUSIGN_CLIENT_SECRET: "your-docusign-client-secret"
DOCUSIGN_USER_ID: "your-docusign-user-id"