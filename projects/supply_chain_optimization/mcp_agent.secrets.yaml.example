# Supply Chain Optimization Agent Secrets
# Copy this file to mcp_agent.secrets.yaml and fill in your actual API keys

anthropic:
  api_key: "sk-ant-your-anthropic-api-key-here"

# Database connection for supply chain data
postgres:
  connection_string: "postgresql://username:password@localhost:5432/supply_chain_db"

# External API keys for supply chain services
apis:
  weather_api_key: "your-weather-api-key"
  logistics_api_key: "your-logistics-provider-api-key" 
  supplier_portal_key: "your-supplier-portal-api-key"